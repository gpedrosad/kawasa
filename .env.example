# Kapso (servidor únicamente — nunca NEXT_PUBLIC_*)
# API key: dashboard Kapso → Project → API Keys
# CLI: npm i -g @kapso/cli && kapso login
# MCP Cursor: Settings → Tools & MCP → Connect "kapso"
KAPSO_API_KEY=your_kapso_api_key
KAPSO_PHONE_NUMBER_ID=623041330889329
KAPSO_WEBHOOK_SECRET=your_webhook_secret

# Opcional (default: https://api.kapso.ai/meta/whatsapp)
# KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp

# Supabase KaWa (servidor — service_role; nunca al browser)
SUPABASE_URL=https://dkpihigjlifjvxiszkew.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clave del panel /crm y APIs internas (Basic Auth). Sin ella no entra nadie.
CRM_PASSWORD=your_crm_password

# Opcional
# LOG_LEVEL=debug
# NODE_ENV=development
# APP_URL=https://kawasa.vercel.app
# SUPP_VOICE_AUDIO_URL=https://kawasa.vercel.app/sounds/supp-voice.ogg

# Meta Conversions API (business_messaging, WhatsApp). Sin token o dataset, conversions queda pending.
# Token: System User con whatsapp_business_management + whatsapp_business_manage_events.
# Dataset: POST /{META_WABA_ID}/dataset (devuelve el existente si ya hay uno).
# META_CAPI_ACCESS_TOKEN=
# META_DATASET_ID=
# META_WABA_ID=1196537218554691
# META_TEST_EVENT_CODE=

# Clave compartida con AgendApp (KAWA_ATTRIBUTION_SECRET en los dos lados, 16+ caracteres)
# KAWA_ATTRIBUTION_SECRET=
